{
  "name": "crowd-monitoring-system",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "npm --workspace backend run dev",
    "dev:python": "cd python-service && ..\\.venv\\Scripts\\python.exe -m uvicorn main:app --host 127.0.0.1 --port 8001 --reload",
    "dev:all": "run_services.bat",
    "build": "npm --workspace backend run build && npm --workspace frontend run build",
    "start": "npm-run-all --parallel start:backend start:frontend",
    "start:frontend": "npm --workspace frontend run start",
    "start:backend": "npm --workspace backend run start",
    "test:youtube": ".\\.venv\\Scripts\\python.exe scripts/test_youtube_connection.py"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.18"
    },
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  }
}

